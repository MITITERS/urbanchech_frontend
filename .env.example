# Base URL the frontend uses to reach the API.
# Empty (the default) means same-origin relative paths: the Vite dev server and
# the production nginx both proxy /api and /_allauth to the backend, so there is
# no CORS setup to do. Set an absolute URL (e.g. https://api.urbancheck.com.ar)
# only if you need to hit a backend on another origin — that requires the
# backend to allow this origin via CORS.
VITE_API_URL=

# Where the dev server forwards the proxied paths. Development only.
# Outside Docker: http://localhost:8000
# Inside docker compose: http://django:8000 (the backend service name)
VITE_API_PROXY_TARGET=http://localhost:8000

# Set to true when the dev server runs inside a container on macOS or Windows
# and hot reload does not pick up file changes.
VITE_USE_POLLING=false

# Docker network of the backend compose stack, which the dev container joins to
# reach `django:8000`. Development only.
BACKEND_NETWORK=urbancheck_backend_default

# Backend that the production image's nginx proxies /api, /_allauth and /media
# to. Read when the container starts, not by Vite.
#
# That nginx adds an X-Forwarded-For hop: the backend has to count it in
# DJANGO_NUM_PROXIES (1, or 2 behind another proxy), or every per-IP rate
# limit would see the nginx address instead of the real client.
API_UPSTREAM=http://django:8000
